#!/usr/bin/env bash
# commit-msg — der git-eigene Traeger der Traceability-Zusage (AGENTS.md §5,
# harness/README.md §Traceability). git uebergibt den Pfad der vorgeschlagenen
# Message-Datei als $1; Exit ungleich 0 bricht den Commit ab.
#
# WARUM ER AM COMMIT HAENGT UND NICHT AM AGENTEN: er sieht jede Commit-Klasse,
# die git selbst erzeugt — auch die aus einem Repo-Werkzeug (`make slice-mv`,
# `archive-welle`) und die `-m`-Form. Die vorgeschlagenen Commit-Klassen und
# ihre Reichweite stehen in harness/README.md §Traceability.
#
# AKTIVIERUNG: `core.hooksPath` ist lokale Konfiguration und reist nicht mit
# dem Klon; `make hooks-install` setzt sie. `git commit --no-verify` umgeht
# diesen Hook. Beides gehoert zur Reichweite, nicht zu ihren Grenzen.
#
# GEBAUT WIE DER COMMIT-PFAD ES VERLANGT (LH-QA-03): bash und coreutils, kein
# Docker, kein d-check-Image, kein Netz. Die Pruefung selbst liegt in
# harness/tools/commit-msg-traceability.sh — harness/tools/, damit shell-lint
# sie deckt.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$here/../harness/tools/commit-msg-traceability.sh" "$@"
