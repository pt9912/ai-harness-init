{
    "permissions": {
        "deny": [
            "Bash(python *)",
            "Bash(python3 *)",
            "Bash(pip *)",
            "Bash(pip3 *)",
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(yarn *)",
            "Bash(pnpm *)",
            "Bash(pipx *)",
            "Bash(uv *)",
            "Bash(uvx *)",
            "Bash(corepack *)",
            "Bash(cargo *)",
            "Bash(rustup *)",
            "Bash(gem *)",
            "Bash(conda *)",
            "Bash(go *)",
            "Bash(gofmt *)",
            "Bash(golangci-lint *)",
            "Bash(staticcheck *)",
            "Bash(perl *)",
            "Bash(ruby *)",
            "Bash(node *)",
            "Bash(deno *)",
            "Bash(bun *)",
            "Bash(apt *)",
            "Bash(apt-get *)",
            "Bash(brew *)",
            "Bash(git push --force *)",
            "Bash(git push -f *)",
            "Bash(git push --force-with-lease *)"
        ],
        "ask": [
            "Bash(git reset --hard *)",
            "Bash(git clean -f*)",
            "Bash(docker system prune *)",
            "Bash(docker buildx prune *)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pretooluse-command-guard.sh"
                    }
                ]
            },
            {
                "matcher": "Agent",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pretooluse-agent-guard.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.harness/state/bin/ai-harness-init span-emit",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.harness/state/bin/ai-harness-init span-emit",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.harness/state/bin/ai-harness-init span-emit",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-require-gates.sh"
                    }
                ]
            }
        ]
    }
}